{
    "name": "Changeolog",
    "version": "1.0.0",
    "description": "Smart changelog generator with web editor",
    "module": "src/cli.ts",
    "type": "module",
    "bin": {
      "Changeolog": "./src/cli.ts"
    },
    "scripts": {
      "start": "bun run src/cli.ts",
      "build": "bun build src/cli.ts --outdir dist --target bun",
      "test": "bun test",
      "dev": "bun --watch src/cli.ts"
    },
    "dependencies": {
      "simple-git": "^3.21.0"
    },
    "devDependencies": {
      "@types/bun": "latest"
    },
    "peerDependencies": {
      "typescript": "^5.0.0"
    }
  }